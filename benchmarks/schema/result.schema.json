{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Infra Benchmark Result",
  "type": "object",
  "required": [
    "date",
    "model",
    "method",
    "environment",
    "metrics"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "model": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": "string"
        },
        "torch": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "config": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "latency_ms_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "latency_ms_p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "latency_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens_per_second": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "perplexity": {
          "type": [
            "number",
            "null"
          ]
        },
        "accuracy": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
